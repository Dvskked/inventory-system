{
    "name": "inventoryflow/inventoryflow",
    "description": "Sistema completo de gestion de inventarios y ventas con PHP y MySQL",
    "type": "project",
    "license": "MIT",
    "keywords": ["php", "mysql", "inventory", "sales", "mvc", "crm", "pos"],
    "authors": [
        {
            "name": "Developer",
            "email": "dev@inventoryflow.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpunit/php-code-coverage": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "InventoryFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InventoryFlow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage/",
        "migrate": "php database/migrate.php",
        "seed": "php database/seed.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
